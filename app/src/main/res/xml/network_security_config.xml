<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cho phép kết nối HTTP rõ ràng (Cleartext) chỉ trong môi trường phát triển cục bộ -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Địa chỉ host máy chủ khi chạy trên Android Emulator -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Loopback và Localhost -->
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- Dải mạng LAN WiFi khi chạy ứng dụng trên thiết bị thật (192.168.x.x, 10.x.x.x) -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>

    <!-- Mặc định khi triển khai production: Bắt buộc HTTPS an toàn -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
